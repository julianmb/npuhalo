ORNITH_ENDPOINT=http://127.0.0.1:8012/v1
# Lemonade's OpenAI-compatible endpoint. For direct FastFlowLM serving, use
# http://127.0.0.1:8001/v1 to match the README launch example.
LFM_NPU_ENDPOINT=http://127.0.0.1:13305/v1
# Verifier backend: auto = use NPU endpoint if reachable, else in-process PyTorch.
# Other values: npu, local
VERIFIER_BACKEND=auto
CHECKPOINT_TOKEN_LIMIT=250
VERIFIER_K=3
VERIFIER_TEMPERATURE=0.7
